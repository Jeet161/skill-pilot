# Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Featherless AI Configuration
FEATHERLESS_API_KEY="your-featherless-api-key"
FEATHERLESS_BASE_URL="https://api.featherless.ai/v1"

# Featherless Model Routing Tiers
FEATHERLESS_CLASSIFIER_MODEL="Qwen/Qwen3.5-9B-Instruct"
FEATHERLESS_QUESTION_MODEL="Qwen/Qwen3.6-27B-Instruct"
FEATHERLESS_REASONING_MODEL="Qwen/Qwen3.6-35B-Instruct"
FEATHERLESS_DEEP_REASONING_MODEL="deepseek-ai/DeepSeek-V4"
FEATHERLESS_VISION_MODEL="google/Gemma-4-31B-Vision"

# Groq API Configuration (High-Speed Latency Tier)
GROQ_API_KEY="your-groq-api-key"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_QUESTION_MODEL="openai/gpt-oss-120b"
GROQ_CLASSIFIER_MODEL="openai/gpt-oss-20b"
GROQ_REASONING_MODEL="qwen/qwen3.6-27b"

# QuizAPI Configuration (External Question Provider)
QUIZAPI_KEY="your-quizapi-key"

# App & Auth Configuration
NEXTAUTH_SECRET="your-random-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
