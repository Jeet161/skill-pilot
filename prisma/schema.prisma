generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIEvaluation {
  id                String            @id @default(cuid())
  questionId        String            @unique
  status            EvaluationStatus
  correctness       Float
  confidence        Float
  errorType         ErrorType         @default(NONE)
  misconception     String?
  understood        Json
  missing           Json
  recommendedAction String
  modelUsed         String
  createdAt         DateTime          @default(now())
  GeneratedQuestion GeneratedQuestion @relation(fields: [questionId], references: [id])
}

model Answer {
  id                String            @id @default(cuid())
  questionId        String            @unique
  rawAnswer         String
  confidence        Int?
  timeTakenMs       Int?
  submittedAt       DateTime          @default(now())
  GeneratedQuestion GeneratedQuestion @relation(fields: [questionId], references: [id])
}

model AssessmentBlueprint {
  id                String            @id @default(cuid())
  sessionId         String            @unique
  subject           String
  goal              String
  raw               Json
  createdAt         DateTime          @default(now())
  AssessmentSession AssessmentSession @relation(fields: [sessionId], references: [id])
}

model AssessmentResult {
  id                          String            @id @default(cuid())
  sessionId                   String            @unique
  overallProficiency          Float
  overallConfidence           Float
  strongAreas                 Json
  developingAreas             Json
  weakAreas                   Json
  uncertainAreas              Json
  misconceptions              Json
  difficultyCeiling           Float
  transferPerformance         Float
  improvementDuringAssessment Float
  recommendedNextAreas        Json
  remainingUncertainties      Json
  summary                     String
  createdAt                   DateTime          @default(now())
  AssessmentSession           AssessmentSession @relation(fields: [sessionId], references: [id])
}

model AssessmentSession {
  id                  String               @id @default(cuid())
  userId              String
  subject             String
  mode                AssessmentMode       @default(BALANCED)
  targetCount         Int                  @default(20)
  askedCount          Int                  @default(0)
  status              AssessmentStatus     @default(BLUEPRINT_PENDING)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  completedAt         DateTime?
  lastAiCallAt        DateTime?
  blueprint           AssessmentBlueprint?
  result              AssessmentResult?
  User                User                 @relation(fields: [userId], references: [id])
  GeneratedQuestion   GeneratedQuestion[]
  Intervention        Intervention[]
  SkillEstimate       SkillEstimate[]
  SkillObservation    SkillObservation[]

  @@index([status])
  @@index([userId])
}

model GeneratedQuestion {
  id                String            @id @default(cuid())
  sessionId         String
  sequence          Int
  conceptId         String
  conceptName       String
  type              QuestionType
  purpose           QuestionPurpose   @default(BASELINE)
  difficulty        Float
  prompt            String
  options           Json?
  correctAnswer     String
  explanation       String
  fingerprint       String
  rationale         String?
  reachedAt         DateTime          @default(now())
  evaluation        AIEvaluation?
  answer            Answer?
  AssessmentSession AssessmentSession @relation(fields: [sessionId], references: [id])
  Intervention      Intervention?

  @@unique([sessionId, fingerprint])
  @@index([sessionId, sequence])
}

model Intervention {
  id                String             @id @default(cuid())
  sessionId         String
  questionId        String?            @unique
  conceptId         String
  conceptName       String
  title             String
  explanation       String
  createdAt         DateTime           @default(now())
  GeneratedQuestion GeneratedQuestion? @relation(fields: [questionId], references: [id])
  AssessmentSession AssessmentSession  @relation(fields: [sessionId], references: [id])
}

model SkillEstimate {
  id                 String            @id @default(cuid())
  sessionId          String
  conceptId          String
  conceptName        String
  proficiency        Float
  evidenceConfidence Float
  evidenceCount      Int               @default(0)
  state              SkillState        @default(UNCERTAIN)
  difficultyCeiling  Float             @default(0)
  transferVerified   Boolean           @default(false)
  updatedAt          DateTime             @updatedAt
  AssessmentSession  AssessmentSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, conceptId])
  @@index([sessionId])
}

model SkillObservation {
  id                String            @id @default(cuid())
  sessionId         String
  conceptId         String
  conceptName       String
  evidenceType      String
  correctness       Float
  difficulty        Float
  createdAt         DateTime          @default(now())
  AssessmentSession AssessmentSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, conceptId])
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String?
  createdAt         DateTime            @default(now())
  AssessmentSession AssessmentSession[]

  @@index([email])
}

enum AssessmentMode {
  BALANCED
  DEEP
  PRACTICAL
  CONCEPTUAL
}

enum AssessmentStatus {
  BLUEPRINT_PENDING
  IN_PROGRESS
  GENERATING_QUESTION
  AWAITING_ANSWER
  COMPLETED
  ABANDONED
  FAILED
}

enum ErrorType {
  NONE
  CONCEPTUAL_GAP
  SYNTAX_ERROR
  LOGIC_ERROR
  TYPE_ERROR
  GUESS
  UNKNOWN
}

enum EvaluationStatus {
  CORRECT
  INCORRECT
  PARTIALLY_CORRECT
  UNCERTAIN
}

enum QuestionPurpose {
  BASELINE
  SAME_CONCEPT_EASIER
  SAME_CONCEPT_DIFFERENT_FORM
  SAME_CONCEPT_HARDER
  PREREQUISITE_TEST
  REMEDIAL_TEST
  TRANSFER_TEST
  RELATED_CONCEPT
  NEW_CONCEPT
  ADVANCED_CONCEPT
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  CODE_OUTPUT
  CODE_WRITING
  DEBUGGING
  CONCEPTUAL_EXPLANATION
  SCENARIO
  PRACTICAL_PROBLEM
}

enum SkillState {
  STRONG
  DEVELOPING
  WEAK
  UNCERTAIN
}
